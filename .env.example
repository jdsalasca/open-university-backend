# Configuración local solamente. Copia a un archivo local ignorado y define secretos fuera del repositorio.
DB_URL=jdbc:mysql://127.0.0.1:3306/universiry_dev
DB_USERNAME=universiry_dev
# Define DB_PASSWORD en la sesión o archivo local ignorado; no se entrega una contraseña por defecto.
# DB_PASSWORD=

# Almacenamiento local de desarrollo y límites iniciales de imagen.
# En producción se debe definir almacenamiento institucional persistente y compartido.
# BRANDING_ASSETS_DIRECTORY=./.data/branding-assets
# BRANDING_ASSETS_MAX_BYTES=5242880
# BRANDING_ASSETS_MAX_WIDTH=8192
# BRANDING_ASSETS_MAX_HEIGHT=8192
# BRANDING_ASSETS_MAX_PIXELS=16777216
# BRANDING_ASSETS_MAX_REQUEST_BYTES=6MB

# La autenticación de producción requiere el issuer y claims institucionales confirmados con DTIC.
# UPTC_OIDC_ISSUER_URI=
# UPTC_OIDC_AUDIENCE=
# UPTC_OIDC_AUTHORITIES_CLAIM=authorities
