# Solo para Docker Compose de desarrollo local. No reutilizar en otro entorno.
MYSQL_DATABASE=universiry_dev
DB_USERNAME=universiry_dev
DB_PASSWORD=universiry_dev_local_only
MYSQL_ROOT_PASSWORD=root_local_only

# El servicio admite límites menores para importar mallas. El máximo del dominio es 2 MiB / 10 000 filas.
ACADEMIC_CATALOG_IMPORT_MAX_FILE_BYTES=2097152
ACADEMIC_CATALOG_IMPORT_MAX_ROWS=10000

# Vacías por defecto. DTIC debe confirmar estos valores; sin issuer y audience el backend no acepta tokens.
UPTC_OIDC_ISSUER_URI=
UPTC_OIDC_AUDIENCE=
UPTC_OIDC_AUTHORITIES_CLAIM=authorities
# JSON grupo/claim -> permisos internos aprobado. Vacío significa cero permisos.
UPTC_OIDC_ROLE_PERMISSION_MAPPING=

# Valores públicos del cliente React; no introducir client_secret ni grupos reales sin aprobación.
# El proveedor debe registrar el callback exacto /auth/callback en el mismo origen de Vite.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_REDIRECT_URI=
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=
VITE_OIDC_SCOPE=openid
